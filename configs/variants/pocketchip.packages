# PocketCHIP variant: awesome with the wibar launcher.

# Window manager. i3 stays installed as a fallback session.
awesome

# Desktop runtime and PICO-8/SunVox dependencies.
python3-gi
unclutter
upower
libsdl2-2.0-0
libsdl2-image-2.0-0
libgl1
libegl1
libgles2

# Applications in the wibar menu.
pcmanfm
mousepad

# Security toolkit. The PocketCHIP is a handheld field unit, so the image
# carries a small set of wireless, network, web and firmware tools. Everything
# here is in trixie armhf; Kali-only packages (metasploit, impacket-scripts,
# responder, seclists) are not packaged for Debian and stay out.
aircrack-ng
arping
bettercap
binwalk
crunch
dsniff
ettercap-text-only
foremost
gobuster
hcxdumptool
hcxtools
hping3
john
macchanger
masscan
ncrack
p0f
proxychains4
python3-scapy
sqlmap
sslscan
tcpflow
testssl.sh
upx-ucl
yara

# OSINT and data collection. theHarvester itself is not packaged for Debian and
# its current upstream needs Python 3.14 plus Playwright, so recon-ng and the
# DNS/whois tooling cover the same collection stage. Shodan and Censys need the
# user's own API keys.
ddgr
dnsenum
dnsrecon
fierce
python3-censys
python3-shodan
recon-ng
wafw00f
whois
