#!/bin/sh
# PocketCHIP variant: LXDE with a bottom panel sized for the 480x272 screen.

if [ -r /etc/default/pocketchip-ui ]; then
  # shellcheck disable=SC1091
  . /etc/default/pocketchip-ui
fi

if [ "${POCKETCHIP_DARK_MODE:-1}" = 1 ]; then
  export GTK_THEME="${GTK_THEME:-Adwaita:dark}"
  export GTK_APPLICATION_PREFER_DARK_THEME=1
fi

[ -r "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"
[ -r "$HOME/.Xmodmap" ] && xmodmap "$HOME/.Xmodmap"

if [ "${POCKETCHIP_LOGIN_SPLASH:-0}" = 1 ] &&
   [ -x /usr/local/bin/pocketchip-splash ]; then
  pocketchip-splash login
fi

xset s 600 600 2>/dev/null || true
xset +dpms 2>/dev/null || true
xset dpms 600 600 600 2>/dev/null || true

# Solid dark root window behind the LXDE desktop.
if command -v xsetroot >/dev/null 2>&1; then
  xsetroot -solid '#32302f' 2>/dev/null || true
fi

# Re-apply the calibration matrix at session start; the Xorg snippet covers
# the normal path, but this also catches a device that appeared late.
if command -v pocketchip-touch-calibrate >/dev/null 2>&1; then
  pocketchip-touch-calibrate apply >/dev/null 2>&1 || true
fi

# Hiding the pointer quickly feels like the cursor jumps away and back on a
# resistive panel; keep it visible for a few seconds after the last touch.
if command -v unclutter >/dev/null 2>&1; then
  unclutter -idle "${POCKETCHIP_UNCLUTTER_IDLE:-4}" -root &
fi

# Mousepad follows the dark desktop with a readable mono font.
if command -v gsettings >/dev/null 2>&1; then
  gsettings set org.xfce.mousepad.preferences.view font-name 'Terminus 10' 2>/dev/null || true
  gsettings set org.xfce.mousepad.preferences.view show-line-numbers true 2>/dev/null || true
  gsettings set org.xfce.mousepad.preferences.view color-scheme 'oblivion' 2>/dev/null || true
fi

# Tray icons for the Wi-Fi and Bluetooth settings.
if command -v nm-applet >/dev/null 2>&1; then
  nm-applet --indicator >/dev/null 2>&1 &
fi
if command -v blueman-applet >/dev/null 2>&1; then
  blueman-applet >/dev/null 2>&1 &
fi

if command -v startlxde >/dev/null 2>&1; then
  exec startlxde
fi
exec lxsession -e LXDE
